# ── Database ──
AGENTOS_DATABASE_URL=

# ── JWT ──
AGENTOS_JWT_SECRET_KEY=
AGENTOS_JWT_ALGORITHM=HS256
AGENTOS_JWT_ACCESS_EXPIRE_MINUTES=15
AGENTOS_JWT_REFRESH_EXPIRE_DAYS=7

# ── Initial admin ──
AGENTOS_ADMIN_USERNAME=
AGENTOS_ADMIN_PASSWORD=

# ── Backend selection ──
USER_SYSTEM_BACKEND=local-users

# ── Home directories ──
AGENTOS_HOME_BASE=/home/agentos/users
AGENTOS_SWARM_TEMPLATE_DIR=/home/agentos/host_root/.jiuwenswarm
AGENTOS_SYS_UID=1000
AGENTOS_SYS_GID=1000

# ── Thirdparty agent artifacts (container paths; compose mounts ${AGENTOS_BASE}/images) ──
THIRDPARTY_AGENT_PACKAGE_DIR=/home/agentos/images/packages
THIRDPARTY_AGENT_IMAGE_DIR=/home/agentos/images
THIRDPARTY_AGENT_ARCHIVE_ENABLED=false

# ── VictoriaMetrics agent metrics config ──
AGENT_METRICS_CONFIG_PATH=/etc/vm/agent-metrics.json

# ── Logging ──
LOG_DIR=/home/agentos/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Log Center ──
LOG_EXPORT_PATH=/var/log/agentos_exports
LOG_INITIAL_TAIL_LINES=100
LOG_MAX_LINE_LENGTH=10000
LOG_MAX_FILES_PER_WS=5
LOG_EXPORT_MAX_CONCURRENT=2
LOG_EXPORT_RETENTION_DAYS=7
LOG_EXPORT_CLEANUP_HOUR=3

# ── LiteLLM ──
LITELLM_ADMIN_URL=
LITELLM_MASTER_KEY=
LITELLM_KEY_ENCRYPTION_KEY=   # 256-bit AES-256-GCM key (64 hex chars). Generate: openssl rand -hex 32
MAX_KEYS_PER_USER=10
LITELLM_REQUEST_TIMEOUT=30.0
# LiteLLM 独立数据库（spend 表所在位置，与项目 AGENTOS_DATABASE_URL 可不同）
LITELLM_DATABASE_URL=

# ── 初始模型（deploy 脚本嗅探后写入；留空则跳过模型注册）──
# INITIAL_MODELS: JSON 字符串，deploy 脚本从推理服务 GET /models 嗅探后写入
# 格式: [{"id":"glm5.2","max_model_len":1048576,"owned_by":"sglang"}]
# API_BASE 需写全地址（含 /v1 或不含，取决于推理服务），示例: http://192.168.1.10:8000/v1
# INITIAL_MODEL_METRICS_URL: 监控采集地址（deploy 脚本用，后端不读）
# INITIAL_INFERENCE_ENGINE: 部署框架如 vllm/sglang（deploy 脚本用，后端不读）
INITIAL_MODELS=
INITIAL_MODEL_API_BASE=
INITIAL_MODEL_API_KEY=
INITIAL_MODEL_METRICS_URL=
INITIAL_INFERENCE_ENGINE=

# ── Hardware monitoring ──
NODE_EXPORTER_HOST=host.docker.internal
NODE_EXPORTER_PORT=8091
NPU_EXPORTER_HOST=host.docker.internal
NPU_EXPORTER_PORT=8092
# master 专用；worker IP 的 JSON 数组，单机留空
WORKER_NODES=
# VictoriaMetrics（master 后端 PromQL 查询地址；Docker 部署时 compose 会注入）
VICTORIAMETRICS_URL=

# ── 注册中心后端 (registry，选填；留空则禁用智能体监控功能) ──
AGENT_REGISTER_URL=

# ── SkillHub 市场 ──
# 一体机本地 SkillHub 前端地址（如 http://192.168.1.10:8098）；为空时安装接口返回 503
# --with-skillhub 部署时由 deploy.sh 自动写入管理面 .env，此处保持默认
SKILLHUB_BASE_URL=
SKILLHUB_REQUEST_TIMEOUT=30.0
# 单个 skill 包大小上限（字节，默认 500MB）
SKILLHUB_MAX_FILE_SIZE=524288000