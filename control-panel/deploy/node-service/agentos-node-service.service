[Unit]
Description=AgentOS Node Service - Inference Service Manager
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agentos/agentos-node-service
EnvironmentFile=/opt/agentos/agentos-node-service/.env
ExecStart=/bin/bash -c '[ -f /usr/local/ascendrc ] && source /usr/local/ascendrc; exec /opt/agentos/agentos-node-service/venv/bin/python -m uvicorn server:app --host __LISTEN_HOST__ --port __LISTEN_PORT__'
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
