# 复制为 .env 后修改

# ── PostgreSQL （建议使用字母/数字组合，请勿填写特殊字符） ──
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── AgentOS JWT (生成: openssl rand -hex 32) ──
AGENTOS_JWT_SECRET_KEY=

# ── AgentOS 初始管理员 ──
AGENTOS_ADMIN_USERNAME=
AGENTOS_ADMIN_PASSWORD=

# ── AgentOS-Manager容器挂载目录（不建议修改） ──
AGENTOS_BASE=/home/agentos
# agentos 系统用户 UID/GID（deploy.sh install 时自动检测，也可手动指定）
AGENTOS_SYS_UID=1000
AGENTOS_SYS_GID=1000
YR_LOG_DIR=/tmp/yr_sessions
JIUWENBOX_LOG_DIR=/tmp/jiuwenbox

# ── LiteLLM ──
# 部署机器的可访问 IP 或域名（后端和浏览器都通过此地址访问 LiteLLM）
# 留空则自动检测本机 IP（通过 ip route get 1 获取默认路由源地址）
# 检测失败时兜底到 127.0.0.1（仅限本机访问）
LITELLM_HOST=
LITELLM_PORT=8100
LITELLM_MASTER_KEY=
# LiteLLM 密钥加密密钥 (生成: openssl rand -hex 32)
LITELLM_KEY_ENCRYPTION_KEY=
# ── 初始模型（deploy 脚本嗅探后写入；留空则跳过模型注册）──
# INITIAL_MODELS: JSON 字符串，deploy 脚本从推理服务 GET /models 嗅探后写入
# 格式: [{"id":"glm5.2","max_model_len":1048576,"owned_by":"sglang"}]
# API_BASE 需写全地址（含 /v1 或不含，取决于推理服务），示例: http://192.168.1.10:8000/v1
# INITIAL_MODEL_METRICS_URL: 监控采集地址（deploy 脚本用，后端不读）
# INITIAL_INFERENCE_ENGINE: 部署框架如 vllm/sglang（deploy 脚本用，后端不读）
INITIAL_MODELS=
INITIAL_MODEL_API_BASE=
INITIAL_MODEL_API_KEY=
INITIAL_MODEL_METRICS_URL=
INITIAL_INFERENCE_ENGINE=

# ── 端口映射 (Postgre和VictoriaMetrics绑定至localhost) ──
FRONTEND_PORT=8090
POSTGRES_PORT=5432
VICTORIAMETRICS_PORT=8428
# Grafana 容器直出端口（仅调试用；控制台 iframe 走 FRONTEND_PORT 的 /grafana/ 反代）
GRAFANA_PORT=8093
# 可选：Grafana 对外 origin（默认 http://127.0.0.1:${FRONTEND_PORT}；/grafana/ 由 compose 拼接）
# 使用自定义域名或 HTTPS 反向代理时填写，例如 https://panel.example.com
# GRAFANA_ROOT_URL=

# ── Hardware monitoring ──
AGENTOS_NODE_ROLE=master
# master 节点 IP（worker 节点必填；用于 Alloy 日志上报等跨节点通信）
# worker 节点安装时可通过环境变量 MASTER_IP=192.168.x.x 传入，或交互输入
MASTER_IP=
# JSON 数组；单机留空 []，多机示例：WORKER_NODES='["192.168.1.11"]'（建议单引号包裹,仅支持ipv4地址）
WORKER_NODES=[]

# ── Node Exporter ──
# 部署机器的可访问 IP（后端通过此地址访问 node_exporter）
# 留空则自动检测本机 IP，检测失败兜底到 127.0.0.1
NODE_EXPORTER_HOST=
NODE_EXPORTER_PORT=8091

# ── NPU Exporter ──
# 部署机器的可访问 IP（后端通过此地址访问 npu_exporter）
# 留空则自动检测本机 IP，检测失败兜底到 127.0.0.1
NPU_EXPORTER_HOST=
NPU_EXPORTER_PORT=8092

# ── Alloy (日志采集，仅 worker 节点生效；master 由 compose 管理) ──
# Loki 写入 endpoint；worker 节点默认由 MASTER_IP 推导: http://<MASTER_IP>:8096/loki/api/v1/push
# master compose 内部默认: http://loki:8096/loki/api/v1/push
ALLOY_LOKI_ENDPOINT=

# ── 注册中心后端 (registry，选填) ──
# 注册中心服务的完整地址，含协议和端口
# 非交互安装模式下默认为 http://<本机IP>:4003
# 交互安装模式下可留空，管理面正常启动，仅"智能体监控"功能不可用
AGENT_REGISTER_URL=

# ── image-process（一般无需配置）──
# 三方 Agent OCI 构建服务；agentos 经 IMAGE_PROCESS_URL 访问（compose 已写死为 http://image-process:8091）
# 仅 image-build 内网可达；依赖宿主机镜像 agent-base:1.0
