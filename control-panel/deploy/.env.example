# 复制为 .env 后修改

# ── PostgreSQL ──
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── AgentOS JWT (生成: openssl rand -hex 32) ──
AGENTOS_JWT_SECRET_KEY=

# ── AgentOS 初始管理员 ──
AGENTOS_ADMIN_USERNAME=
AGENTOS_ADMIN_PASSWORD=

# ── AgentOS-Manager容器挂载目录（不建议修改） ──
AGENTOS_BASE=/home/agentos
YR_LOG_DIR=/tmp/yr_sessions/latest/log

# ── LiteLLM ──
# 部署机器的可访问 IP 或域名（后端和浏览器都通过此地址访问 LiteLLM）
LITELLM_HOST=localhost
LITELLM_PORT=4000
LITELLM_MASTER_KEY=
# LiteLLM 密钥加密密钥 (生成: openssl rand -hex 32)
LITELLM_KEY_ENCRYPTION_KEY=

# ── 端口映射 (Postgre和VictoriaMetrics绑定至localhost) ──
FRONTEND_PORT=8080
POSTGRES_PORT=5432
VICTORIAMETRICS_PORT=8428

# ── Hardware monitoring ──
AGENTOS_HOSTNAME=
AGENTOS_PRODUCT_NAME=

# ── Node Exporter ──
# 部署机器的可访问 IP（后端通过此地址访问 node_exporter）
# Linux 服务器需替换为本机 IP，例如: 192.168.1.100
NODE_EXPORTER_HOST=127.0.0.1
NODE_EXPORTER_PORT=8084

# ── NPU Exporter ──
# 同上，Linux 服务器需替换为本机 IP
NPU_EXPORTER_HOST=127.0.0.1
NPU_EXPORTER_PORT=8083

# ── 注册中心后端 (registry，选填；留空则禁用智能体监控功能) ──
# 注册中心服务的完整地址，含协议和端口
# 同机部署: http://host.docker.internal:8000
# 远程部署: http://192.168.0.20:8000
# 留空则管理面正常启动，仅"智能体监控"功能不可用
AGENT_REGISTER_URL=
