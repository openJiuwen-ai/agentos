# 复制为 .env 后修改

# ── PostgreSQL ──
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── AgentOS JWT (生成: openssl rand -hex 32) ──
AGENTOS_JWT_SECRET_KEY=

# ── AgentOS 初始管理员 ──
AGENTOS_ADMIN_USERNAME=
AGENTOS_ADMIN_PASSWORD=

# ── AgentOS-Manager容器挂载目录（不建议修改） ──
AGENTOS_BASE=/home/agentos
YR_LOG_DIR=/tmp/yr_sessions/latest/log

# ── LiteLLM ──
# 部署机器的可访问 IP 或域名（后端和浏览器都通过此地址访问 LiteLLM）
# 留空则自动检测本机 IP（通过 ip route get 1 获取默认路由源地址）
# 检测失败时兜底到 127.0.0.1（仅限本机访问）
LITELLM_HOST=
LITELLM_PORT=8100
LITELLM_MASTER_KEY=
# LiteLLM 密钥加密密钥 (生成: openssl rand -hex 32)
LITELLM_KEY_ENCRYPTION_KEY=

# ── 端口映射 (Postgre和VictoriaMetrics绑定至localhost) ──
FRONTEND_PORT=8090
POSTGRES_PORT=5432
VICTORIAMETRICS_PORT=8428
# Grafana 容器直出端口（仅调试用；控制台 iframe 走 FRONTEND_PORT 的 /grafana/ 反代）
GRAFANA_PORT=8093
# 可选：Grafana 对外 origin（默认 http://127.0.0.1:${FRONTEND_PORT}；/grafana/ 由 compose 拼接）
# 使用自定义域名或 HTTPS 反向代理时填写，例如 https://panel.example.com
# GRAFANA_ROOT_URL=

# ── Hardware monitoring ──
AGENTOS_NODE_ROLE=master
# JSON 数组；单机留空 []，多机示例：WORKER_NODES='["192.168.1.11"]'（建议单引号包裹,仅支持ipv4地址）
WORKER_NODES=[]

# ── Node Exporter ──
# 部署机器的可访问 IP（后端通过此地址访问 node_exporter）
# 留空则自动检测本机 IP，检测失败兜底到 127.0.0.1
NODE_EXPORTER_HOST=
NODE_EXPORTER_PORT=8091

# ── NPU Exporter ──
# 部署机器的可访问 IP（后端通过此地址访问 npu_exporter）
# 留空则自动检测本机 IP，检测失败兜底到 127.0.0.1
NPU_EXPORTER_HOST=
NPU_EXPORTER_PORT=8092

# ── 注册中心后端 (registry，选填) ──
# 注册中心服务的完整地址，含协议和端口
# 非交互安装模式下默认为 http://<本机IP>:4003
# 交互安装模式下可留空，管理面正常启动，仅"智能体监控"功能不可用
AGENT_REGISTER_URL=

# ── image-process（一般无需配置）──
# 三方 Agent OCI 构建服务；agentos 经 IMAGE_PROCESS_URL 访问（compose 已写死为 http://image-process:8091）
# 仅 image-build 内网可达；依赖宿主机镜像 agent-base:1.0
