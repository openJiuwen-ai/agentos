local.file_match "control_panel" {
  path_targets = [{
    __path__  = "/home/agentos/logs/*.log",
    category  = "control_panel",
    host      = constants.hostname,
    ip        = "127.0.0.1",
  }]
}

local.file_match "jiuwenswarm" {
  path_targets = [{
    __path__  = "/home/agentos/users/*/.jiuwenswarm/**/*.log",
    category  = "jiuwenswarm",
    host      = constants.hostname,
    ip        = "127.0.0.1",
  }]
}

// 通途拆分成两个: agent-gateway + agent-registry
local.file_match "agent_gateway" {
  path_targets = [{
    __path__  = "/var/log/agentos/gateway.log",
    category  = "agent-gateway",
    host      = constants.hostname,
    ip        = "127.0.0.1",
  }]
}

local.file_match "agent_registry" {
  path_targets = [{
    __path__  = "/var/log/agentos/agent-registry.log",
    category  = "agent-registry",
    host      = constants.hostname,
    ip        = "127.0.0.1",
  }]
}

local.file_match "agent_runtime" {
  path_targets = [{
      __path__  = "/var/log/agentos/yr_sessions/latest/logs/**/*.{log,err,out}",
      category  = "agent-runtime",
      host      = constants.hostname,
      ip        = "127.0.0.1",
  }]
}

local.file_match "jiuwenbox" {
  path_targets = [{
    __path__  = "/tmp/jiuwenbox/*.log",
    category  = "jiuwenbox",
    host      = constants.hostname,
    ip        = "127.0.0.1",
  }]
}

loki.source.file "control_panel_logs" {
  targets    = local.file_match.control_panel.targets
  forward_to = [loki.write.default.receiver]
}

loki.source.file "jiuwenswarm_logs" {
  targets    = local.file_match.jiuwenswarm.targets
  forward_to = [loki.write.default.receiver]
}

loki.source.file "agent_gateway_logs" {
  targets    = local.file_match.agent_gateway.targets
  forward_to = [loki.write.default.receiver]
}

loki.source.file "agent_registry_logs" {
  targets    = local.file_match.agent_registry.targets
  forward_to = [loki.write.default.receiver]
}

loki.source.file "agent_runtime_logs" {
  targets    = local.file_match.agent_runtime.targets
  forward_to = [loki.write.default.receiver]
}

loki.source.file "jiuwenbox_logs" {
  targets    = local.file_match.jiuwenbox.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:8096/loki/api/v1/push"
  }
}

logging {
  level = "info"
}
