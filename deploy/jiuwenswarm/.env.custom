CLUSTER_HOSTS=""
YR_PYTHON_VERSION="3.11"
YR_FUNC_CODE_DIR=""
JIUWENSWARM_INSTANCE_NAME=""
GATEWAY_CONCURRENCY=1
GATEWAY_INVOKE_TIMEOUT=60
GATEWAY_SESSION_MAP_SCOPE="per_chat_bot_user"
EXTENSION_DIRS=""
FUNC_SVC_NAME="0@jiuwen@swarm"
MGR_CPU=300
MGR_MEMORY=600
MGR_MIN_INSTANCE=1
MGR_MAX_INSTANCE=10
MGR_CONCURRENT_NUM=10
MODEL_PROVIDER=""
MODEL_NAME=""
API_BASE=""
API_KEY=""
EMBED_API_KEY=""
EMBED_API_BASE=""
EMBED_MODEL=""
MASTER_NODE_IP=""
FRONTEND_PORT="8888"
FUNCTION_ID="sn:cn:yrk:default:function:0@jiuwen@swarm:latest"
SANDBOX_TYPE="supervisor"
# ETCD_ENDPOINTS 留空时由 check_handler 从 config.yaml etcd_nodes 拼 http://ip:32379,...
# Cron 默认 etcd（jiuwenclaw AgentOS 模板 / global_vars），此处无需配 CRON_STORE_BACKEND
ETCD_ENDPOINTS=""

# === web one-click startup (2026-07-27) ===
# gateway process listen address/port (app_gateway.py reads GATEWAY_HOST/GATEWAY_PORT/WEB_PORT)
# GATEWAY_HOST/WEB_HOST 留空时由部署脚本自动绑定 config.yaml 的 ingress_virtual_ip(VIP)
GATEWAY_HOST=""
GATEWAY_PORT="19001"
WEB_PORT="19000"
# web frontend static server listen address/port (app_web.py reads FRONTEND_HOST/FRONTEND_PORT)
FRONTEND_HOST="0.0.0.0"
WEB_STATIC_PORT="5173"
# whether to start web frontend during `up` (yes/no)
WEB_ENABLED="yes"

TOOL_SANDBOX_TYPE="yuanrong"
TOOL_SANDBOX_ENABLE="true"
TOOL_SANDBOX_IMAGE="swr.cn-southwest-2.myhuaweicloud.com/yuanrong-dev/yr-runtime-sandbox:latest"
TOOL_SANDBOX_EXECUTOR="docker"
# 工具沙箱 CPU 限制（毫核，1000=1核）
TOOL_SANDBOX_CPU=1000
# 工具沙箱内存限制（MB）
TOOL_SANDBOX_MEMORY=2048
TOOL_SANDBOX_USER="agentos"
TOOL_SANDBOX_GROUP="agentos"